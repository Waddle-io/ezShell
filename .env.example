# ezShell Environment Variables Template
# Copy this file to .env.local and replace with your actual Groq API key:
#   cp .env.example .env.local

# Get your free key at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: Override default model (default: llama-3.1-8b-instant)
# EZSHELL_MODEL=llama-3.1-8b-instant

# Optional: Override language (fr or en)
# EZSHELL_LANG=fr
