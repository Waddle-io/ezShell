# --- Serveur uniquement : ne jamais exposer au client, ne jamais commiter .env.local ---
# Neon : utilise la chaîne "pooled" (host avec -pooler) et ?sslmode=require
DATABASE_URL=
GROQ_API_KEY=
LLM_MODEL=                # nom du modèle, configurable sans redéployer le code
TOKEN_PEPPER=             # secret long et aléatoire (openssl rand -hex 32) : hache les jetons d'appareil
ANON_DAILY_LIMIT=10       # essai sans compte (requêtes par jour et par appareil)
FREE_DAILY_LIMIT=50       # compte gratuit (M3) : à ajuster après mesure du coût réel
BURST_PER_MINUTE=10       # rafale : requêtes par minute et par appareil
REGISTER_PER_IP_HOUR=10   # enregistrements d'appareils par IP et par heure
GLOBAL_DAILY_SPEND_CAP=2000  # plafond global (requêtes/jour) : au-delà, mode limité (503)
KILL_SWITCH=0             # 1 = désactive les appels au LLM (peut aussi être basculé en base)
# GROQ_BASE_URL=          # tests : pointer vers un faux Groq local
